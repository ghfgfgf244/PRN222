@page
@model Web_.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<h2>Đặt lại mật khẩu</h2>

<form method="post">
    <input type="hidden" asp-for="Token" />

    <label>Mật khẩu mới:</label>
    <input type="password" asp-for="NewPassword" required />

    <label>Xác nhận mật khẩu:</label>
    <input type="password" asp-for="ConfirmPassword" required />

    <button type="submit">Đặt lại mật khẩu</button>
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="text-success">@TempData["SuccessMessage"]</div>
}
