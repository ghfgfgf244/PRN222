@page
@model Web_.Pages.Account.ForgotPasswordModel
@{
}
<form method="post">
    <label>Email:</label>
    <input type="email" asp-for="Email" required />
    <button type="submit">Gửi yêu cầu</button>
</form>
@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger">@TempData["ErrorMessage"]</div>
}