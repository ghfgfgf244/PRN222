@page
@model Web_.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<h2>Đăng nhập</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Form đăng nhập thông thường -->
<form method="post">
    <div class="form-group mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" placeholder="Nhập email..." />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Mật khẩu</label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <button type="submit" class="btn btn-primary">Đăng nhập</button>
    </div>
</form>

<hr />

<!-- Form đăng nhập bằng Google (tách riêng) -->
<form method="post" asp-page-handler="GoogleLogin">
    <button type="submit" class="btn btn-danger">
        <i class="fab fa-google"></i> Đăng nhập bằng Google
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
