@page
@model Web_.Pages.DoctorLeafs.CreateModel

@{
    ViewData["Title"] = "Tạo đơn nghỉ phép";
    Layout = "_LayoutMain";

}

<h1>Tạo đơn nghỉ phép</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="DoctorLeaf.LeaveDate" class="control-label"></label>
                <input asp-for="DoctorLeaf.LeaveDate" type="date" class="form-control" />
                <span asp-validation-for="DoctorLeaf.LeaveDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DoctorLeaf.Reason" class="control-label"></label>
                <textarea asp-for="DoctorLeaf.Reason" class="form-control" rows="4"></textarea>
                <span asp-validation-for="DoctorLeaf.Reason" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Gửi đơn</button>
        </form>
    </div>
</div>


<div>
    <a asp-page="Index">← Quay lại danh sách</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
