@page
@model Web_.Pages.DoctorLeafs.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DoctorLeaf[0].LeaveDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DoctorLeaf[0].Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DoctorLeaf[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DoctorLeaf[0].Doctor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.DoctorLeaf) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LeaveDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Doctor.FullName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.LeaveId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.LeaveId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.LeaveId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
