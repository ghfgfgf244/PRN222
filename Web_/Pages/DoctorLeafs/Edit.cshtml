@page
@model Web_.Pages.DoctorLeafs.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>DoctorLeaf</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DoctorLeaf.LeaveId" />
            <div class="form-group">
                <label asp-for="DoctorLeaf.DoctorId" class="control-label"></label>
                <select asp-for="DoctorLeaf.DoctorId" class="form-control" asp-items="ViewBag.DoctorId"></select>
                <span asp-validation-for="DoctorLeaf.DoctorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DoctorLeaf.LeaveDate" class="control-label"></label>
                <input asp-for="DoctorLeaf.LeaveDate" class="form-control" />
                <span asp-validation-for="DoctorLeaf.LeaveDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DoctorLeaf.Reason" class="control-label"></label>
                <input asp-for="DoctorLeaf.Reason" class="form-control" />
                <span asp-validation-for="DoctorLeaf.Reason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DoctorLeaf.CreatedAt" class="control-label"></label>
                <input asp-for="DoctorLeaf.CreatedAt" class="form-control" />
                <span asp-validation-for="DoctorLeaf.CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
