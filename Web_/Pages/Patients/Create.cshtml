@page
@model Web_.Pages.Patients.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Patient</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Patient.RegisteredBy" class="control-label"></label>
                <select asp-for="Patient.RegisteredBy" class ="form-control" asp-items="ViewBag.RegisteredBy"></select>
            </div>
            <div class="form-group">
                <label asp-for="Patient.FullName" class="control-label"></label>
                <input asp-for="Patient.FullName" class="form-control" />
                <span asp-validation-for="Patient.FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Patient.Age" class="control-label"></label>
                <input asp-for="Patient.Age" class="form-control" />
                <span asp-validation-for="Patient.Age" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Patient.Gender" /> @Html.DisplayNameFor(model => model.Patient.Gender)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Patient.Note" class="control-label"></label>
                <input asp-for="Patient.Note" class="form-control" />
                <span asp-validation-for="Patient.Note" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
